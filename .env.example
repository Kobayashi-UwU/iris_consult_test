# Copy to .env for local development. On Railway, set these as service Variables.

# From Google AI Studio. Only needed for Live mode and scripts/build_cache.py.
GEMINI_API_KEY=
# First model in the fallback chain. Optional GEMINI_MODELS=comma,separated,chain overrides the whole chain.
GEMINI_MODEL=gemini-3.8-flash
# demo | live
APP_MODE=demo
# Empty = local SQLite (local.db). Railway injects its Postgres URL.
DATABASE_URL=
LLM_CONCURRENCY=2
SHORTLIST_SIZE=12
BORDERLINE_BAND=5
