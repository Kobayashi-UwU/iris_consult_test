# Copy to .env for local development. On Railway, set these as service Variables.

# From Google AI Studio. Only needed for Live mode and scripts/build_cache.py.
GEMINI_API_KEY=
# Check the current Flash model name in AI Studio.
GEMINI_MODEL=gemini-2.5-flash
# demo | live
APP_MODE=demo
# Empty = local SQLite (local.db). Railway injects its Postgres URL.
DATABASE_URL=
LLM_CONCURRENCY=2
SHORTLIST_SIZE=12
BORDERLINE_BAND=5
